@article{cosh_relationship_2024,
	abstract = {The adverse impacts of climate change on mental health is a burgeoning area, although findings are inconsistent. The emerging concept of eco-anxiety represents distress in relation to climate change and may be related to mental health. The aim of this study was to explore the relationship between eco-anxiety with validated mental health outcomes, specifically psychological distress and symptoms of major affective disorders.},
